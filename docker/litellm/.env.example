# Absolute path directly containing config.json, tokenizer files and weights.
MODEL_DIR=/absolute/path/to/Qwen3-4B
DEVICE=/dev/davinci0

FINER_IMAGE=ghcr.io/huawei-llm-inference-framework/finer:0.2.0-beta-2026.11.02
# Quick Start default; pin a release tag or digest for a repeatable deployment.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:latest
LITELLM_BIND=127.0.0.1
LITELLM_PORT=4000

# Fill these before using Compose. See README.md for generation commands.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Use a hex password so it is also safe inside DATABASE_URL.
POSTGRES_PASSWORD=
